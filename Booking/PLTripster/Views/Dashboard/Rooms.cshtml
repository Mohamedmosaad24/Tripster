@model IEnumerable<BLTripster.ViewModels.RoomListVM>

@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Rooms";
}

<div class="container-fluid px-4">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h3 class="h3 mb-0 text-gray-800">
            <i class="fas fa-bed text-primary mr-2"></i>
            Rooms Management
        </h3>

        <a asp-action="AddRoom"
           asp-controller="Dashboard"
           class="btn btn-primary shadow-sm px-4">
            <i class="fas fa-plus mr-1"></i>
            Add Room
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Rooms List
            </h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="thead-light">
                        <tr>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Price</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No rooms available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var room in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">@room.RoomType</td>
                                    <td>@room.Capacity</td>
                                    <td>$@room.Price</td>

                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a asp-action="EditRoom"
                                           asp-controller="Dashboard"
                                           asp-route-id="@room.Id"
                                           class="btn btn-warning btn-sm mr-2 shadow-sm">
                                            <i class="fas fa-pen mr-1"></i>
                                            Edit
                                        </a>

                                        <!-- Delete (POST Form) -->
                                        <form asp-action="DeleteRoom"
                                              asp-controller="Dashboard"
                                              method="post"
                                              style="display:inline;">

                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@room.Id" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm shadow-sm"
                                                    onclick="return confirm('Are you sure you want to delete this room?');">
                                                <i class="fas fa-trash mr-1"></i>
                                                Delete
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>