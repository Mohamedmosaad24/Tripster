@model IEnumerable<BLTripster.ViewModels.RoomListVM>
@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Rooms";
}

<div class="container-fluid px-4">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h3 class="h3 mb-0 text-gray-800">
            <i class="fas fa-bed text-primary mr-2"></i>
            Rooms Management
        </h3>

        <a asp-action="AddRoom"
           asp-controller="Dashboard"
           class="btn btn-primary shadow-sm px-4">
            <i class="fas fa-plus mr-1"></i>
            Add Room
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Rooms List
            </h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="thead-light">
                        <tr>
                            <th>Room Type</th>
                            <th>Capacity</th>
                            <th>Price</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No rooms available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var room in Model)
                            {
                                <tr>
                                    <td class="font-weight-bold">@room.RoomType</td>
                                    <td>@room.Capacity</td>
                                    <td>$@room.Price</td>

                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a asp-action="EditRoom"
                                           asp-controller="Dashboard"
                                           asp-route-id="@room.Id"
                                           class="btn btn-warning btn-sm mr-2 shadow-sm">
                                            <i class="fas fa-pen mr-1"></i>
                                            Edit
                                        </a>

                                        <!-- Delete -->
                                        <button type="button"
                                                class="btn btn-danger btn-sm shadow-sm"
                                                data-toggle="modal"
                                                data-target="#deleteModal"
                                                data-id="@room.Id">
                                            <i class="fas fa-trash mr-1"></i>
                                            Delete
                                        </button>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

<!-- ================= DELETE MODAL ================= -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle mr-2"></i>
                    Confirm Delete
                </h5>
                <button type="button" class="close text-white" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <div class="modal-body text-center">
                Are you sure you want to delete this room?
            </div>

            <div class="modal-footer justify-content-center">

                <form asp-action="DeleteRoom"
                      asp-controller="Dashboard"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="deleteRoomId"
                           name="id" />

                    <button type="button"
                            class="btn btn-secondary">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger ml-2">
                        Yes, Delete
                    </button>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#deleteModal').on('show.bs.modal', function (event) {

            var button = $(event.relatedTarget);
            var roomId = button.data('id');

            $('#deleteRoomId').val(roomId);
        });
    </script>
}
