@using DATripster.Entities
@model User
@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Add User";
}

<div class="container-fluid px-4">
    <h2 class="mb-4">Add New User</h2>
    <div class="card shadow mb-4">
        <div class="card-body">
            <form asp-action="Create" asp-controller="Dashboard" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Cairo, Egypt" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Nationality" class="form-label"></label>
                    <input asp-for="Nationality" class="form-control" placeholder="e.g. Egyptian" />
                </div>
                <div class="form-group mb-3">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Profile Image</label>
                    <div class="d-flex align-items-center gap-3">
                        <img id="userAddPreview" src="/images/default-user.png" alt="Preview" class="rounded" width="80" height="80" style="object-fit:cover; border: 2px solid #e2e8f0; display:none;" />
                        <input type="file" name="ProfileImage" class="form-control" accept="image/*" onchange="previewImg(this, 'userAddPreview')" />
                    </div>
                    <small class="text-muted">Choose a profile image from your computer (JPG, PNG, GIF)</small>
                </div>
                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Add User</button>
                    <a asp-action="AllUsers" asp-controller="Dashboard" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImg(input, previewId) {
            var preview = document.getElementById(previewId);
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
