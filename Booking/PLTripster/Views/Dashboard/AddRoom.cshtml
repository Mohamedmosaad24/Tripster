@model BLTripster.ViewModels.RoomVM
@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Add Room";
}

<div class="container-fluid px-4">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h3 class="h3 mb-0 text-gray-800">
            <i class="fas fa-bed mr-2 text-primary"></i>
            Add New Room
        </h3>
    </div>

    <!-- Card -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Room Information
            </h6>
        </div>

        <div class="card-body p-4">

            <form asp-action="AddRoom"
                  asp-controller="Dashboard"
                  method="post" enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <!-- Room Type -->
                <div class="form-group">
                    <label asp-for="RoomType" class="font-weight-bold"></label>
                    <input asp-for="RoomType" class="form-control" />
                    <span asp-validation-for="RoomType" class="text-danger small"></span>
                </div>

                <!-- Capacity -->
                <div class="form-group">
                    <label asp-for="Capacity" class="font-weight-bold"></label>
                    <input asp-for="Capacity" class="form-control" />
                </div>

                <!-- Price -->
                <div class="form-group">
                    <label asp-for="Price" class="font-weight-bold"></label>
                    <input asp-for="Price" class="form-control" />
                </div>

                <!-- Room Image -->
                <div class="form-group">
                    <label class="font-weight-bold">Room Image</label>
                    <div class="d-flex align-items-center gap-3">
                        <img id="roomAddPreview" alt="Preview" class="rounded" width="80" height="80" style="object-fit:cover; border: 2px solid #e2e8f0; display:none;" />
                        <input type="file" name="RoomImage" class="form-control" accept="image/*" onchange="previewImg(this, 'roomAddPreview')" />
                    </div>
                    <small class="text-muted">Choose a room image from your computer (JPG, PNG, GIF)</small>
                </div>

                <!-- Hotel -->
                <div class="form-group">
                    <label asp-for="HotelId" class="font-weight-bold"></label>
                    <select asp-for="HotelId" asp-items="ViewBag.Hotels" class="form-control"></select>
                    <span asp-validation-for="HotelId" class="text-danger small"></span>
                </div>

                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary px-4 shadow-sm">
                        <i class="fas fa-save mr-1"></i>
                        Save
                    </button>

                    <a asp-action="Rooms" asp-controller="Dashboard"
                       class="btn btn-secondary px-4 ml-2">
                        <i class="fas fa-arrow-left mr-1"></i>
                        Back
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

<script>
    function previewImg(input, previewId) {
        var preview = document.getElementById(previewId);
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                preview.src = e.target.result;
                preview.style.display = 'block';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>

