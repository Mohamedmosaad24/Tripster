@model BLTripster.ViewModels.RoomVM
@{
    Layout = "_DashLayout";
    ViewData["Title"] = "Add Room";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-primary text-white rounded-top-4 py-3">
                    <h4 class="mb-0">
                        <i class="fa-solid fa-bed me-2"></i>
                        Add New Room
                    </h4>
                </div>

                <div class="card-body p-4">

                    <form method="post">

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Room Type</label>
                            <input asp-for="RoomType" class="form-control rounded-3" placeholder="Enter room type" />
                            <span asp-validation-for="RoomType" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Capacity</label>
                            <input asp-for="Capacity" class="form-control rounded-3" placeholder="Number of guests" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Price</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control rounded-end-3" placeholder="Enter price" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Hotel Id</label>
                            <input asp-for="HotelId" class="form-control rounded-3" placeholder="Enter hotel ID" />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary rounded-pill py-2 fw-semibold">
                                <i class="fa-solid fa-check me-1"></i> Save Room
                            </button>
                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>



@section Scripts {
    <script>
        document.querySelectorAll('.form-control').forEach(input => {
            input.addEventListener('focus', function() {
                this.style.boxShadow = "0 0 0 0.2rem rgba(13,110,253,.25)";
            });
            input.addEventListener('blur', function() {
                this.style.boxShadow = "none";
            });
        });
    </script>
}


