@using DATripster.Entities
@model User
@{
    Layout = "_DashLayout";
}
<div class="container mt-4">
    <h2>Edit User</h2>

    <form action="/Dashboard/Edit" method="post">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group mb-3">
            <label for="Name">Name</label>
            <input type="text" name="Name" value="@Model.Name" class="form-control" required />
        </div>

        <div class="form-group mb-3">
            <label for="Email">Email</label>
            <input type="email" name="Email" value="@Model.Email" class="form-control" required />
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-success">Save</button>
            <a href="/Dashboard/AllUsers" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>