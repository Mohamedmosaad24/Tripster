<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PLTripster</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PLTripster.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
          integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/improvements.css" asp-append-version="true" />


    <style>
        /* Dark mode – applied when html has data-theme="dark" */
        html[data-theme="dark"] { color-scheme: dark; }
        html[data-theme="dark"] body { background-color: #1a1a2e; color: #e4e4e7; }
        html[data-theme="dark"] .header-wrap { background-color: #16213e !important; border-bottom: 1px solid #2d3748; }
        html[data-theme="dark"] .header-wrap .sitename { color: #f4f4f5 !important; }
        html[data-theme="dark"] .header-wrap .nav-link { color: #d4d4d8 !important; }
        html[data-theme="dark"] .header-wrap .nav-link:hover { color: #a5b4fc !important; }
        html[data-theme="dark"] .tripster-footer { background-color: #16213e; color: #a1a1aa; border-top: 1px solid #2d3748; }
        html[data-theme="dark"] .tripster-footer a { color: #d4d4d8 !important; }
        html[data-theme="dark"] .tripster-footer a:hover { color: #a5b4fc !important; }
        html[data-theme="dark"] .tripster-footer h5 { color: #f4f4f5; }
        html[data-theme="dark"] .scroll-top { background: #2d3748; color: #e4e4e7; }
        html[data-theme="dark"] .scroll-top:hover { background: #3d4a5c; }
        html[data-theme="dark"] .card, html[data-theme="dark"] .card-full { background-color: #1e293b; border-color: #334155; color: #e4e4e7; }
        html[data-theme="dark"] .bg-light { background-color: #16213e !important; }
        html[data-theme="dark"] .dropdown-menu { background-color: #1e293b; border-color: #334155; }
        html[data-theme="dark"] .dropdown-item { color: #e4e4e7; }
        html[data-theme="dark"] .dropdown-item:hover { background-color: #334155; }
        html[data-theme="dark"] .user-dropdown-header { background-color: transparent; }

        /* ===== COMPREHENSIVE DARK MODE TEXT FIXES ===== */
        /* Override Bootstrap text-dark everywhere */
        html[data-theme="dark"] .text-dark { color: #e4e4e7 !important; }
        html[data-theme="dark"] .text-body { color: #e4e4e7 !important; }
        html[data-theme="dark"] .text-muted { color: #a1a1aa !important; }
        html[data-theme="dark"] .text-secondary { color: #a1a1aa !important; }
        html[data-theme="dark"] .text-black-50 { color: #9ca3af !important; }

        /* Headings, paragraphs, labels, spans */
        html[data-theme="dark"] h1, html[data-theme="dark"] h2, html[data-theme="dark"] h3,
        html[data-theme="dark"] h4, html[data-theme="dark"] h5, html[data-theme="dark"] h6 { color: #f4f4f5; }
        html[data-theme="dark"] p { color: #d4d4d8; }
        html[data-theme="dark"] label { color: #d4d4d8; }
        html[data-theme="dark"] span { color: inherit; }
        html[data-theme="dark"] small { color: #a1a1aa; }

        /* Forms */
        html[data-theme="dark"] .form-control { background-color: #1e293b; color: #e4e4e7; border-color: #334155; }
        html[data-theme="dark"] .form-control::placeholder { color: #6b7280; }
        html[data-theme="dark"] .form-control:focus { background-color: #1e293b; color: #e4e4e7; border-color: #6366f1; }
        html[data-theme="dark"] .form-control-plaintext { color: #e4e4e7; }
        html[data-theme="dark"] .form-label { color: #d4d4d8; }
        html[data-theme="dark"] .form-select { background-color: #1e293b; color: #e4e4e7; border-color: #334155; }
        html[data-theme="dark"] .input-group-text { background-color: #334155; color: #d4d4d8; border-color: #334155; }

        /* Tables */
        html[data-theme="dark"] .table { color: #e4e4e7; }
        html[data-theme="dark"] .table th { color: #f4f4f5; }
        html[data-theme="dark"] .table td { color: #d4d4d8; border-color: #334155; }
        html[data-theme="dark"] .table thead th { border-color: #334155; }
        html[data-theme="dark"] .table-striped tbody tr:nth-of-type(odd) { background-color: rgba(255,255,255,0.03); }
        html[data-theme="dark"] .table-hover tbody tr:hover { background-color: rgba(255,255,255,0.05); }

        /* Hero / search section */
        html[data-theme="dark"] #HeroContainer { color: #e4e4e7; }
        html[data-theme="dark"] #HeroContainer h1 { color: #f4f4f5; }
        html[data-theme="dark"] .search-pill-container { background-color: #1e293b; border-color: #334155; }
        html[data-theme="dark"] .search-group label { color: #d4d4d8; }
        html[data-theme="dark"] .search-group input { color: #e4e4e7; }

        /* Hotel cards and details */
        html[data-theme="dark"] .hotel-card { background-color: #1e293b; }
        html[data-theme="dark"] .hotel-title { color: #f4f4f5; }
        html[data-theme="dark"] .hotel-loc { color: #a1a1aa; }
        html[data-theme="dark"] .hotel-body { color: #d4d4d8; }
        html[data-theme="dark"] .hotel-price { color: #e4e4e7; }
        html[data-theme="dark"] .dest-label { color: #ffffff; }

        /* Breadcrumbs, badges, alerts */
        html[data-theme="dark"] .breadcrumb { background-color: transparent; }
        html[data-theme="dark"] .breadcrumb-item a { color: #818cf8; }
        html[data-theme="dark"] .breadcrumb-item.active { color: #a1a1aa; }
        html[data-theme="dark"] .alert { border-color: #334155; }

        /* Links general */
        html[data-theme="dark"] a:not(.btn):not(.nav-link):not(.dropdown-item) { color: #818cf8; }
        html[data-theme="dark"] a:not(.btn):not(.nav-link):not(.dropdown-item):hover { color: #a5b4fc; }

        /* Modal */
        html[data-theme="dark"] .modal-content { background-color: #1e293b; color: #e4e4e7; border-color: #334155; }
        html[data-theme="dark"] .modal-header { border-color: #334155; }
        html[data-theme="dark"] .modal-footer { border-color: #334155; }

        /* Review cards & sidebar */
        html[data-theme="dark"] #Sidebar { background-color: #16213e; color: #e4e4e7; border-right-color: #2d3748; }
        html[data-theme="dark"] #Sidebar a { color: #d4d4d8; }
        html[data-theme="dark"] #SideTitle { color: #f4f4f5; }
        html[data-theme="dark"] #MenuText { color: #d4d4d8; }
        html[data-theme="dark"] #MenuItem { color: #d4d4d8; }
        html[data-theme="dark"] #MenuItem:hover { background-color: #1e293b; }
        html[data-theme="dark"] #MenuItemActive { background: #1e293b; color: #818cf8; }
        html[data-theme="dark"] #BackArrow { background-color: #1e293b; border-color: #334155; color: #e4e4e7; }
        html[data-theme="dark"] #BackArrow:hover { background-color: #334155; }
        html[data-theme="dark"] #Logout { color: #d4d4d8; }
        html[data-theme="dark"] #Logout:hover { background-color: #1e293b; }

        /* User profile main content */
        html[data-theme="dark"] #Main { background-color: #1a1a2e; }
        html[data-theme="dark"] #MainTitle { color: #f4f4f5; }
        html[data-theme="dark"] #MainSub { color: #a1a1aa; }
        html[data-theme="dark"] #Key { color: #d4d4d8; }
        html[data-theme="dark"] #Val { color: #e4e4e7; }
        html[data-theme="dark"] #Avatar { border-color: #334155; }
        html[data-theme="dark"] .IconDot { color: #a1a1aa; }
        html[data-theme="dark"] #Menu a:hover .IconDot { color: #e4e4e7; }

        /* User profile promo card */
        html[data-theme="dark"] #PromoCard { background-color: #1e293b; border-color: #334155; }
        html[data-theme="dark"] #PromoTitle { color: #f4f4f5; }
        html[data-theme="dark"] #PromoText { color: #a1a1aa; }
        html[data-theme="dark"] #PromoBtn { color: #818cf8; border-color: #818cf8; }
        html[data-theme="dark"] #PromoBtn:hover { background-color: rgba(129, 140, 248, 0.1); }
        html[data-theme="dark"] #PromoIcon { color: #fbbf24; }

        /* Notification dropdown */
        .notif-dropdown { width: 360px; max-height: 420px; overflow-y: auto; padding: 0; border-radius: 12px; box-shadow: 0 10px 40px rgba(0,0,0,0.15); }
        .notif-header { padding: 14px 18px; font-weight: 700; font-size: 1rem; border-bottom: 1px solid #e5e7eb; }
        .notif-item { padding: 12px 18px; border-bottom: 1px solid #f3f4f6; display: flex; gap: 12px; align-items: flex-start; transition: background 0.15s; cursor: pointer; }
        .notif-item:hover { background-color: #f9fafb; }
        .notif-item:last-child { border-bottom: none; }
        .notif-icon { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.9rem; }
        .notif-icon.green { background: #dcfce7; color: #16a34a; }
        .notif-icon.blue  { background: #dbeafe; color: #2563eb; }
        .notif-icon.amber { background: #fef3c7; color: #d97706; }
        .notif-icon.red   { background: #fee2e2; color: #dc2626; }
        .notif-text { font-size: 0.875rem; color: #374151; line-height: 1.4; }
        .notif-text strong { font-weight: 600; }
        .notif-time { font-size: 0.75rem; color: #9ca3af; margin-top: 2px; }
        .notif-footer { text-align: center; padding: 10px; border-top: 1px solid #e5e7eb; }
        .notif-footer a { font-size: 0.8rem; color: #6366f1; font-weight: 600; text-decoration: none; }
        .notif-footer a:hover { text-decoration: underline; }
        .notif-unread { background-color: #f0f5ff; }
        html[data-theme="dark"] .notif-dropdown { background-color: #1e293b; border-color: #334155; }
        html[data-theme="dark"] .notif-header { color: #f4f4f5; border-color: #334155; }
        html[data-theme="dark"] .notif-item { border-color: #2d3748; }
        html[data-theme="dark"] .notif-item:hover { background-color: #334155; }
        html[data-theme="dark"] .notif-text { color: #d4d4d8; }
        html[data-theme="dark"] .notif-time { color: #6b7280; }
        html[data-theme="dark"] .notif-footer { border-color: #334155; }
        html[data-theme="dark"] .notif-unread { background-color: rgba(99,102,241,0.1); }

        #theme-toggle { cursor: pointer; border: none; background: none; padding: 0; font-size: 1.25rem; color: inherit; }
        #theme-toggle:hover { opacity: 0.8; }
        
        /* Scroll to top button */
        .scroll-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #007bff;
            color: white;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            box-shadow: 0 4px 12px rgba(0, 123, 255, 0.3);
            z-index: 1000;
            transition: all 0.3s ease;
            opacity: 0;
            visibility: hidden;
        }
        
        .scroll-top.active {
            opacity: 1;
            visibility: visible;
        }
        
        .scroll-top:hover {
            background: #0056b3;
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(0, 123, 255, 0.4);
        }
    </style>
</head>
<body>
    <script>
        (function() {
            var theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <header class="header-wrap bg-light sticky-top p-2 d-flex align-items-center shadow-sm" style="height:80px">
        <div class="container-fluid d-flex align-items-center justify-content-between">

            <!-- LEFT: Logo -->
            <div class="d-flex align-items-center">
                <a asp-action="Index" asp-controller="Home" class="text-decoration-none">
                    <h1 class="sitename fw-bold text-dark m-0" style="font-size:1.8rem; letter-spacing:1px;">
                        <i class="fa-solid fa-plane-departure me-2 text-primary"></i>
                        Tripster
                    </h1>
                </a>
            </div>

            <!-- CENTER: Navbar -->
            <nav class="d-none d-md-flex justify-content-center flex-grow-1">
                <ul class="navbar-nav flex-row gap-4">

                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-dark" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-house me-1"></i> Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-dark" asp-controller="Reviews" asp-action="Reviews">
                            <i class="fa-solid fa-star me-1"></i> Reviews
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link fw-semibold text-dark" asp-controller="Search" asp-action="Result">
                            <i class="fa-solid fa-magnifying-glass me-1"></i> Search
                        </a>
                    </li>

                </ul>
            </nav>

            <!-- RIGHT: Auth / Profile -->
            <div class="d-flex align-items-center gap-3">

                <button type="button"
                        id="theme-toggle"
                        class="nav-link p-0 border-0 bg-transparent"
                        title="Toggle dark mode"
                        style="font-size:1.25rem; color: #6c757d;"
                        aria-label="Toggle dark mode">
                    <i id="theme-icon" class="fa-solid fa-moon"></i>
                </button>

                @if (!User.Identity?.IsAuthenticated ?? true)
                {
                    <a class="btn btn-outline-primary rounded-pill fw-semibold px-4" asp-controller="Account" asp-action="Register">
                        <i class="fa-solid fa-user-plus me-1"></i> Sign Up
                    </a>

                    <a class="btn btn-primary rounded-pill fw-semibold px-4" asp-controller="Account" asp-action="Login">
                        <i class="fa-solid fa-right-to-bracket me-1"></i> Log In
                    </a>
                }
                else
                {
                    <div class="dropdown d-inline-block">
                        <a class="nav-link p-0 position-relative" href="#" id="notifDropdown" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Notifications" style="font-size:1.25rem; color: #6c757d;">
                            <i class="fa-solid fa-bell"></i>
                            <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size:0.65rem;">3</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right notif-dropdown" aria-labelledby="notifDropdown">
                            <div class="notif-header">Notifications</div>
                            <div class="notif-item notif-unread">
                                <div class="notif-icon green"><i class="fa-solid fa-circle-check"></i></div>
                                <div>
                                    <div class="notif-text"><strong>Booking Confirmed!</strong> Your stay at Golden Nile Hotel from Feb 20–25 is confirmed.</div>
                                    <div class="notif-time">2 hours ago</div>
                                </div>
                            </div>
                            <div class="notif-item notif-unread">
                                <div class="notif-icon blue"><i class="fa-solid fa-tag"></i></div>
                                <div>
                                    <div class="notif-text"><strong>Special Offer!</strong> Get 20% off your next stay. Use code <strong>TRIP20</strong>.</div>
                                    <div class="notif-time">5 hours ago</div>
                                </div>
                            </div>
                            <div class="notif-item notif-unread">
                                <div class="notif-icon amber"><i class="fa-solid fa-star"></i></div>
                                <div>
                                    <div class="notif-text"><strong>Rate Your Stay</strong> — How was your recent stay at Red Sea Resort? Leave a review!</div>
                                    <div class="notif-time">1 day ago</div>
                                </div>
                            </div>
                            <div class="notif-footer">
                                <a href="#" onclick="markAllRead(); return false;">Mark all as read</a>
                            </div>
                        </div>
                    </div>

                    @await Component.InvokeAsync("UserMenu")
                }
            </div>

        </div>
    </header>


    <div class="container-fluid ">
        @RenderBody()
    </div>
    <footer class="tripster-footer py-4">
        <div class="container-fluid d-flex justify-content-between flex-wrap align-items-center px-4">

            <div class="">
                <h5 class="mb-1">Tripster</h5>
                <p class="mb-0 small">Your favorite hotel booking</p>
                <p class="mb-0 small"> experience since 1997!</p>
                <p class="small text-muted mb-0 mt-5">Uizard © 2022</p>
            </div>

            <ul class="list-unstyled d-flex mb-0 flex-column">
                <li class="ms-3"><a href="#" class="text-decoration-none small text-dark fw-bold">Help</a></li>
                <li class="ms-3"><a href="#" class="text-decoration-none small text-dark">FAQ</a></li>
                <li class="ms-3"><a href="#" class="text-decoration-none small text-dark">Customer service</a></li>
                <li class="ms-3"><a href="#" class="text-decoration-none small text-dark">How to guide</a></li>
                <li class="ms-3"><a href="#" class="text-decoration-none small text-dark">Contact us</a></li>
            </ul>

        </div>
    </footer>
    <!-- Scroll Top -->
    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <!-- Preloader -->
    <!-- Vendor JS Files -->

    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"
            integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
            integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js"
            integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6"
            crossorigin="anonymous"></script>
    <!-- Main JS File -->
    <script src="~/js/site.js"></script>
    <script>
        (function() {
            var toggle = document.getElementById('theme-toggle');
            var icon = document.getElementById('theme-icon');
            if (!toggle || !icon) return;
            function setIcon(theme) {
                icon.className = theme === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
            }
            setIcon(document.documentElement.getAttribute('data-theme') || 'light');
            toggle.addEventListener('click', function() {
                var html = document.documentElement;
                var theme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                setIcon(theme);
            });
        })();
    </script>
    <script>
        // Scroll to top functionality
        const scrollTopBtn = document.getElementById('scroll-top');
        
        window.addEventListener('scroll', function() {
            if (window.pageYOffset > 300) {
                scrollTopBtn.classList.add('active');
            } else {
                scrollTopBtn.classList.remove('active');
            }
        });
        
        scrollTopBtn.addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
        
        function markAllRead() {
            document.querySelectorAll('.notif-unread').forEach(function(el) {
                el.classList.remove('notif-unread');
            });
            var badge = document.getElementById('notif-badge');
            if (badge) badge.style.display = 'none';
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
