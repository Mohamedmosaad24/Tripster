@using DATripster.Entities
@model List<Booking>

<div class="container mt-5">
    <h3 class="mb-4 text-primary">My Bookings</h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You don't have any bookings yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        @* عرض أول صورة للفندق *@
                        @if (booking.Room?.Hotel?.Images?.Any() == true)
                        {
                            <img src="@booking.Room.Hotel.Images.First().ImageUrl" class="card-img-top" alt="@booking.Room.Hotel.Name" style="height:200px; object-fit:cover;">
                        }

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@booking.Room?.Hotel?.Name</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@booking.Room?.RoomType</h6>

                            <p class="card-text mb-1"><strong>Check In:</strong> @(booking.CheckIn?.ToShortDateString() )</p>
                            <p class="card-text mb-1"><strong>Check Out:</strong> @(booking.CheckOut?.ToShortDateString())</p>
                            <p class="card-text mb-3"><strong>Total Price:</strong> @booking.TotalPrice $</p>

                            <form asp-controller="User" asp-action="CancelBooking" method="post" class="mt-auto"
                                  onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                <input type="hidden" name="bookingId" value="@booking.Id" />
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="fa-solid fa-xmark"></i> Cancel
                                </button>
                            </form>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
