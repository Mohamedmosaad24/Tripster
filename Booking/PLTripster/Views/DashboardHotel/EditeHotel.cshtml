@using BLTripster.ViewModels
@model EditHotelVM
@{
    Layout = "_DashLayout";
}
<div class="m-4">
<h2>Edit Hotel</h2>

<form asp-action="SaveEditHotel" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Address</label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="row mb-3">
        <div class="col">
            <label>Latitude</label>
            <input asp-for="Latitude" class="form-control" />
        </div>
        <div class="col">
            <label>Longitude</label>
            <input asp-for="Longitude" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label>Upload New Images (optional, max 5)</label>
        <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
</div>