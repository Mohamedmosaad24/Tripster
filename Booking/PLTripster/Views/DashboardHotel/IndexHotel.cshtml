@using BLTripster.ViewModels
@model List<HotelListVM>

@{
    Layout = "_DashLayout";
    ViewData["Title"] = "All Hotels";
}

<div class="container-fluid px-4">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h3 class="h3 mb-0 text-gray-800">
            <i class="fas fa-hotel text-primary mr-2"></i>
            Hotels Management
        </h3>

        <a asp-action="AddHotel"
           asp-controller="DashboardHotel"
           class="btn btn-primary shadow-sm px-4">
            <i class="fas fa-plus mr-1"></i>
            Add Hotel
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Hotels List
            </h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">

                    <thead class="thead-light">
                        <tr>
                            <th>#</th>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Address</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No hotels available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Count; i++)
                            {
                                var hotel = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>

                                    <td>
                                        @if (hotel.ImageUrls != null && hotel.ImageUrls.Any())
                                        {
                                            <img src="~/assets/hotelImg/@hotel.ImageUrls.First()"
                                                 alt="@hotel.Name"
                                                 class="img-thumbnail"
                                                 style="width: 100px; height: 70px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Image</span>
                                        }
                                    </td>

                                    <td class="font-weight-bold">@hotel.Name</td>
                                    <td>@hotel.Address</td>

                                    <td style="max-width: 250px;">
                                        <span class="text-truncate d-inline-block"
                                              style="max-width: 250px;">
                                            @hotel.Description
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <a asp-action="EditeHotel"
                                           asp-route-id="@hotel.Id"
                                           class="btn btn-sm btn-warning mr-2 shadow-sm">
                                            <i class="fas fa-pen mr-1"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@hotel.Id"
                                           class="btn btn-sm btn-danger shadow-sm"
                                           onclick="return confirm('Are you sure you want to delete this hotel?');">
                                            <i class="fas fa-trash mr-1"></i>
                                            Delete
                                        </a>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>