@using BLTripster.ViewModels
@model List<HotelListVM>

@{
    Layout = "_DashLayout";
}

<div class="m-4">

<h2>All Hotels</h2>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>#</th>
            <th>Image</th>
            <th>Name</th>
            <th>Address</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < Model.Count; i++)
        {
            var hotel = Model[i];
            <tr>
                <td>@(i + 1)</td>
                <td>
                    @if (hotel.ImageUrls != null && hotel.ImageUrls.Any())
                    {
                        <img src="~/assets/hotelImg/@hotel.ImageUrls.First()"
                             alt="@hotel.Name"
                             style="width: 100px; height: 60px; object-fit: cover;" />
                    }
                </td>
                <td>@hotel.Name</td>
                <td>@hotel.Address</td>
                <td>@hotel.Description</td>
                <td>
                    <a asp-action="EditeHotel" asp-route-id="@hotel.Id" class="btn btn-sm btn-primary">
                        Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@hotel.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Are you sure you want to delete this hotel?');">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
