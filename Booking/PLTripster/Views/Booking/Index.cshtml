@using BLTripster.ViewModels
@model BookingPageVM
@{
    ViewData["Title"] = "Book Room";
}

<main class="container my-5">
    <div class="row g-5">

        <!-- LEFT SIDE -->
        <div class="col-lg-7">
            <h2 class="fw-bold mb-4">
                Book @Model.HotelName
            </h2>

            <form asp-action="ConfirmBooking" asp-controller="Booking" method="post" id="booking-form">

                @Html.AntiForgeryToken()

                <input type="hidden" name="RoomId" value="@Model.Form.RoomId" />
                <input type="hidden" name="UserId" value="@Model.Form.UserId" />

                <!-- Dates -->
                <div class="mb-3">
                    <label for="CheckIn">Check-in</label>
                    <input type="date" name="CheckIn" id="CheckIn" class="form-control" value="@Model.Form.CheckIn?.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="mb-3">
                    <label for="CheckOut">Check-out</label>
                    <input type="date" name="CheckOut" id="CheckOut" class="form-control" value="@Model.Form.CheckOut?.ToString("yyyy-MM-dd")" required />
                </div>

                <!-- Guest -->
                <div class="mb-3">
                    <label for="GuestFullName">Guest full name</label>
                    <input type="text" name="GuestFullName" id="GuestFullName" class="form-control" value="@Model.Form.GuestFullName" required />
                </div>

                <div class="mb-3">
                    <label for="GuestEmail">Guest email</label>
                    <input type="email" name="GuestEmail" id="GuestEmail" class="form-control" value="@Model.Form.GuestEmail" />
                </div>

                <div class="mb-3">
                    <label for="GuestPhone">Guest phone</label>
                    <input type="text" name="GuestPhone" id="GuestPhone" class="form-control" value="@Model.Form.GuestPhone" />
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 py-3 rounded-pill fw-bold">
                    Book now
                </button>
            </form>
        </div>

        <!-- RIGHT SIDE -->
        <div class="col-lg-5">
            <div class="card shadow-sm rounded-4 sticky-top" style="top:2rem">

                <img src="@Model.MainImageUrl"
                     class="card-img-top rounded-4"
                     alt="Room Image" />

                <div class="card-body">
                    <h5 class="fw-bold">@Model.HotelName</h5>
                    <p class="text-muted">@Model.RoomTypeName</p>

                    <div class="d-flex justify-content-between">
                        <span>Price per night</span>
                        <strong>$@Model.PricePerNight</strong>
                    </div>
                </div>
            </div>
        </div>

    </div>
</main>