@model WebTripster.ViewModels.BookingFormVM

<div class="col-lg-7">
    <form asp-action="ConfirmBooking" method="post">
        <input type="hidden" asp-for="RoomId" />

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label small">Check-in</label>
                <input type="date" asp-for="CheckIn" class="form-control" />
                <span asp-validation-for="CheckIn" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label small">Check-out</label>
                <input type="date" asp-for="CheckOut" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label small">First and Last name</label>
            <input type="text" asp-for="GuestFullName" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary rounded-pill w-100 py-3 mt-4">Book now</button>
    </form>
</div>