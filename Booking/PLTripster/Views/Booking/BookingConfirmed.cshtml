@model BLTripster.ViewModels.BookingSuccessVM
@{
    ViewData["Title"] = "Booking Confirmed";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<body class="bg-white">

    <main class="container my-5">

        <div class="row align-items-center mb-5">

            <!-- ================= HOTEL CARD ================= -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm p-2 rounded-4">

                    <img src="@Model.MainImageUrl" class="card-img-top rounded-4" alt="Hotel Room">

                    <div class="card-body">

                        <h5 class="fw-bold mb-1">
                            @Model.HotelName
                        </h5>

                        <p class="text-muted small mb-4">
                            @Model.RoomType
                        </p>

                        <div class="mb-4">

                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted fw-bold">Check-in</span>
                                <strong>
                                    @Model.CheckIn.ToString("dddd, dd MMMM yyyy")
                                </strong>
                            </div>

                            <div class="d-flex justify-content-between small mb-2">
                                <span class="text-muted fw-bold">Check-out</span>
                                <strong>
                                    @Model.CheckOut.ToString("dddd, dd MMMM yyyy")
                                </strong>
                            </div>

                        </div>

                        <hr>

                        <div class="d-flex justify-content-between fw-bold">
                            <span>Total Paid</span>
                            <span>$@Model.TotalPrice</span>
                        </div>

                    </div>
                </div>
            </div>


            <!-- ================= SUCCESS MESSAGE ================= -->
            <div class="col-lg-7 text-center">

                <div class="mb-4">
                    <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center"
                        style="width:100px;height:100px;">
                        <i class="bi bi-check-lg text-success fs-1"></i>
                    </div>
                </div>

                <h2 class="fw-bold mb-3">
                    Your booking is now confirmed!
                </h2>

                <p class="text-muted">
                    Thank you for choosing <strong>Tripster</strong>.
                    We look forward to your stay.
                </p>

                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-3">
                    Back to Home
                </a>

            </div>

        </div>


        <!-- ================= TRIP DETAILS ================= -->
        <div class="pt-5">

            <h4 class="fw-bold mb-5">
                Your trip starts
                @Model.CheckIn.ToString("dddd, dd MMMM yyyy")
            </h4>

            <div class="row mb-4 align-items-center">
                <div class="col-md-2">
                    <span class="fw-bold small">
                        <i class="bi bi-calendar-check me-2"></i>
                        Check-in
                    </span>
                </div>
                <div class="col-md-10 text-muted">
                    @Model.CheckIn.ToString("dddd, dd MMMM yyyy")
                </div>
            </div>

            <div class="row mb-4 align-items-center">
                <div class="col-md-2">
                    <span class="fw-bold small">
                        <i class="bi bi-calendar-x me-2"></i>
                        Check-out
                    </span>
                </div>
                <div class="col-md-10 text-muted">
                    @Model.CheckOut.ToString("dddd, dd MMMM yyyy")
                </div>
            </div>

            <hr class="my-5">

            <div class="row mb-4">
                <div class="col-md-2">
                    <span class="fw-bold small">
                        Hotel address
                    </span>
                </div>
                <div class="col-md-10 text-muted">
                    @Model.HotelAddress
                </div>
            </div>

        </div>

    </main>

</body>
