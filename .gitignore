# ================================
# Visual Studio / .NET safe ignore
# ================================

# Visual Studio folder
.vs/

# Build results
bin/
obj/

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Rider / VS Code (اختياري وآمن)
.idea/
.vscode/

# OS generated files
.DS_Store
Thumbs.db

# ================================
# Logs
# ================================
*.log

# ================================
# EF Core
# ================================
# (مهم) لا تحذف Migrations
# بس امنع ملفات temp
**/Migrations/*.csproj*

# ================================
# Publish
# ================================
publish/
